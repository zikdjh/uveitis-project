APP_ENVIRONMENT=development
APP_MODEL_MODE=mock
APP_DATA_DIR=data
APP_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/postgres
APP_REDIS_URL=redis://127.0.0.1:6380/0
APP_SESSION_TTL_SECONDS=28800
APP_COOKIE_SECURE=false
APP_BOOTSTRAP_DOCTOR_USERNAME=doctor
APP_BOOTSTRAP_DOCTOR_PASSWORD=change-this-doctor-password
APP_BOOTSTRAP_ADMIN_USERNAME=admin
APP_BOOTSTRAP_ADMIN_PASSWORD=change-this-admin-password
APP_MAX_UPLOAD_BYTES=26214400

# Set APP_MODEL_MODE=remote after the core inference services are available.
APP_PERCEPTION_SERVICE_URL=
APP_RETRIEVAL_SERVICE_URL=
APP_DECISION_SERVICE_URL=
APP_DECISION_ENABLED=false
APP_VECTOR_COLLECTION_NAME=uveitis_knowledge
APP_VECTOR_DIMENSION=1024
APP_VECTOR_PROVIDER=local
APP_BGE_M3_MODEL_PATH=models/bge-m3
APP_BGE_M3_BATCH_SIZE=8
APP_BGE_M3_MAX_LENGTH=1024
APP_VECTOR_TOP_K=5
