APP_ENVIRONMENT=development
APP_COOKIE_SECURE=true
APP_MODEL_MODE=mock
APP_DATA_DIR=data
APP_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/postgres
APP_REDIS_URL=redis://127.0.0.1:6380/0
# Fail fast instead of waiting 130 seconds when PostgreSQL is unavailable.
APP_DATABASE_CONNECT_TIMEOUT_SECONDS=5
APP_ACCESS_TOKEN_TTL_SECONDS=900
APP_REFRESH_TOKEN_TTL_SECONDS=2592000
APP_REFRESH_ROTATION_GRACE_SECONDS=30
APP_LOGIN_MAX_ATTEMPTS=5
APP_LOGIN_WINDOW_SECONDS=900
APP_TRUST_PROXY_HEADERS=false
# 唯一管理员账号固定为 root；此变量只用于首次创建账号。
# root 的密码哈希在 t_data_dictionary.f_value_text 中以 AES-GCM 密文保存，
# t_user.f_password_hash 只保留占位值。
# root 已存在后，环境变量变化不会覆盖密码；修改密码必须直接更新数据字典记录。
APP_BOOTSTRAP_ADMIN_PASSWORD=replace-with-root-admin-password
APP_MAX_UPLOAD_BYTES=26214400
APP_ANALYSIS_JOB_LEASE_SECONDS=300
APP_ANALYSIS_JOB_MAX_ATTEMPTS=2
APP_ANALYSIS_WORKER_POLL_SECONDS=2
APP_INTEGRATION_SECRET_KEY=replace-with-at-least-32-random-characters

# Set APP_MODEL_MODE=remote to enable the optional model integrations below.
# Each enhancement is independently optional. A failed or missing branch is
# skipped and never blocks safety review or the editable report.
APP_QWEN_JUDGMENT_ENABLED=true
# Raw case and image data are allowed only for project-owned model services on
# loopback, private, .local, .internal, or .test hosts.
APP_PERCEPTION_SERVICE_URL=http://127.0.0.1:8010
APP_RETRIEVAL_SERVICE_URL=http://127.0.0.1:8011
# The supplementary decision model keeps its slot in the tool chain, but its
# training is deferred, so the service stays disabled and the chain marks the
# slot as skipped instead of dropping it.
APP_DECISION_SERVICE_URL=
APP_DECISION_ENABLED=false
APP_RAG_ENABLED=true
APP_INTERNAL_SERVICE_TOKEN=
APP_INTEGRATION_TIMEOUT_SECONDS=12
# Includes first-request model loading on the local GPU runtime. Warm requests
# are expected to be much faster; raise this only for controlled cold starts.
APP_PERCEPTION_TIMEOUT_SECONDS=90

# External integrations are configured only by an administrator in the admin
# "Service configuration" page. Runtime reads connections and keys from the
# data dictionary; API keys are AES-GCM encrypted and are never returned by
# the API. The service page remains the supported administrator workflow.
APP_SUMMARY_TIMEOUT_SECONDS=20
# Keep disabled so sandbox/runtime proxy variables do not redirect external API
# requests to a closed local port. Set a proxy explicitly when one is required.
APP_EXTERNAL_NETWORK_TRUST_ENV=false
APP_EXTERNAL_NETWORK_PROXY=

# Optional AgentScope planning layer for the judgment tool chain.
# Install it with: uv sync --extra agent
# When disabled, unavailable, or failing, the deterministic chain order is
# used and the case analysis still completes.
APP_AGENT_ORCHESTRATION_ENABLED=false
APP_AGENT_PLANNER_PROTOCOL=openai_chat_completions
APP_AGENT_PLANNER_BASE_URL=
APP_AGENT_PLANNER_API_KEY=
APP_AGENT_PLANNER_MODEL=
# Reuse the administrator-managed external summary credentials when the
# dedicated planner variables above are empty.
APP_AGENT_PLANNER_USE_SUMMARY_CREDENTIALS=true
APP_AGENT_PLANNER_MAX_STEPS=6
APP_AGENT_PLANNER_TIMEOUT_SECONDS=30

APP_VECTOR_COLLECTION_NAME=uveitis_knowledge
APP_VECTOR_DIMENSION=1024
# remote requires the BGE-M3 embedding FastAPI service in bge-m3
# (default port 8011). Set APP_VECTOR_PROVIDER=memory only for link tests
# without semantic vectors.
APP_VECTOR_PROVIDER=remote
APP_VECTOR_TOP_K=5
